      "description": "Opt-in glass capsule using upstream renderer"
    },
    {
      "id": "vyra-navigation-motion",
      "status": "upstream-preference-reused-overlay-pending-build",
      "description": "Accessible selected-tab and icon-state animations"
    },
    {
      "id": "vyra-player-style",
      "status": "planned",
      "description": "Opt-in player appearance customization"
    }
  ],
  "safety": {
    "preserveDefaultUi": true,
    "requireMasterSwitch": true,
    "respectReducedMotion": true,
    "noProprietaryApkRedistribution": true,
    "noAutomaticExecutionOfUntrustedBundles": true
  },
  "validation": {
    "workflow": "Build VYRA YouTube patch bundle",
