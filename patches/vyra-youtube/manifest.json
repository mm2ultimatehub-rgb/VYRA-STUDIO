    "vyra_glass_opacity": 20,
    "vyra_glass_roundness": 30,
    "vyra_accent_color": "system",
    "vyra_player_style": "default"
  },
  "modules": [
    {
      "id": "vyra-settings",
      "status": "source-overlay-implemented-build-pending",
      "description": "VYRA MOD settings page and preference storage"
    },
    {
      "id": "vyra-glass-navigation",
      "status": "upstream-renderer-reused-overlay-pending-build",
